FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         CrankNicolson 0.2;//Euler;//backward;
}

gradSchemes
{
    default         fourth;//Gauss linear;
}

divSchemes
{
    default         Gauss linear;

    div(phi,U)      Gauss linear;//limitedLinearV 1;
    div(phi,Yi_h)   Gauss limitedLinear 1;//limitedLinear 1;
    div(phi,K)      Gauss linear;//limitedLinear 1;
    div(phid,p)     Gauss linear;//limitedLinear 1;
    div(phi,epsilon) Gauss linear;//limitedLinear 1;
    div(phi,k) Gauss linear//limitedLinear 1;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;//linear;
    div(phiU,p)     Gauss linear;//limitedLinear 1;
    div(vk) Gauss linear;//linear;
}

laplacianSchemes
{
    default         Gauss linear orthogonal;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;//orthogonal;
}

fluxRequired
{
    default         no;
    p;
    pd;
}


